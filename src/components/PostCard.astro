---
import type { Post } from '../lib/posts';
import { postPath, readMinutes, formatDate } from '../lib/posts';
import { categoryOf } from '../lib/categories';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const href = postPath(post);
const date = formatDate(post.data.publishDate);
const mins = readMinutes(post);
const category = categoryOf(post);
---

<article class="card">
  <a href={href} class="card-link">
    <div class="cover">
      {post.data.cover ? (
        <img src={post.data.cover} alt={post.data.title} width="1200" height="675" loading="lazy" decoding="async" />
      ) : (
        <div class="placeholder" aria-hidden="true"></div>
      )}
      <span class="badge" style={`background:${category.badge.bg};color:${category.badge.fg}`}>{category.label}</span>
    </div>
    <h2>{post.data.title}</h2>
    {post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
    <div class="meta">
      <span>{date}</span>
      {post.data.locationName && (
        <>
          <span class="dot"></span>
          <span>{post.data.locationName}</span>
        </>
      )}
      <span class="dot"></span>
      <span>{mins} min</span>
    </div>
  </a>
</article>

<style>
  /* Additive only — base .card styles live in global.css. */
  .card {
    transition: transform 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
  }
  .card .cover {
    position: relative;
    border-radius: 10px;
  }
  .cover .placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--rule), var(--rule-strong));
  }
  .badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 1;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    line-height: 1;
  }
  /* Keep grid rows even by clamping the excerpt to two lines. */
  .card .excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
