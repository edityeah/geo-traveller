---
import Base from '../../layouts/Base.astro';
import CommentSection from '../../components/CommentSection.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import LikeButton from '../../components/LikeButton.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import Subscribe from '../../components/Subscribe.astro';
import EmbedScripts from '../../components/EmbedScripts.astro';
import { getAllPosts, postSlug, tagSlug, readMinutes, formatDate } from '../../lib/posts';
import { blogPostingLd, breadcrumbLd, countWords, deriveDescription, SITE } from '../../lib/seo';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const mins = readMinutes(post);
const slug = postSlug(post);
const url = `${SITE.url}/posts/${slug}/`;
const description = post.data.excerpt || deriveDescription(post.body);
const wordCount = countWords(post.body);
const publishDate = post.data.originalDate ?? post.data.publishDate;
const displayDate = formatDate(publishDate);
const isoDate = publishDate.toISOString();

// Breadcrumb category: use the post's primary tag (linked to its tag page)
// instead of a blanket "Archive". Prefer a real section/place; fall back to the
// first meaningful tag; only use Archive if the post has no tags at all.
const tags = post.data.tags ?? [];
const CATEGORY_PRIORITY = [
  'Bhutan', 'Himachal Pradesh', 'Uttar Pradesh', 'Karnataka', 'India',
  'Geo Daily', 'Flight', 'Festival', 'Visa', 'Food', 'Hotels',
];
const GENERIC_TAGS = new Set(['guide', 'how-to', 'travel']);
function pickCategory(): { name: string; url: string } {
  for (const c of CATEGORY_PRIORITY) {
    const hit = tags.find((t) => t.toLowerCase() === c.toLowerCase());
    if (hit) return { name: hit, url: `/tags/${tagSlug(hit)}/` };
  }
  const firstReal = tags.find((t) => !GENERIC_TAGS.has(t.toLowerCase())) ?? tags[0];
  if (firstReal) return { name: firstReal, url: `/tags/${tagSlug(firstReal)}/` };
  return { name: 'Archive', url: '/archive/' };
}
const category = pickCategory();

const ld = [
  blogPostingLd({
    title: post.data.title,
    description,
    url,
    imageUrl: post.data.cover,
    publishDate,
    modifiedDate: post.data.publishDate,
    tags: post.data.tags ?? [],
    wordCount,
    readingMinutes: mins,
  }),
  breadcrumbLd([
    { name: 'Home', url: '/' },
    category,
    { name: post.data.title, url: `/posts/${slug}/` },
  ]),
];
---

<Base
  title={post.data.title}
  description={description}
  ogImage={post.data.cover}
  publishedTime={publishDate}
  modifiedTime={post.data.publishDate}
  ogType="article"
  articleTags={post.data.tags}
  articleAuthor={SITE.author.name}
  jsonLd={ld}
  preloadImage={post.data.cover}
>
  <ReadingProgress />
  <article class="with-sidebar">
    <div class="main-col post-main">
      <Breadcrumbs crumbs={[
        { name: 'Home', url: '/' },
        category,
        { name: post.data.title },
      ]} />
      <header class="post-header">
        <div class="kicker">
          {category.name}
          {post.data.locationName && ` · ${post.data.locationName}`}
        </div>
        <h1>{post.data.title}</h1>
        {post.data.excerpt && <p class="lede">{post.data.excerpt}</p>}
        <p class="post-dateline">
          <span class="byline">By {SITE.author.name}</span>
          <span aria-hidden="true">·</span>
          <span>Published <time datetime={isoDate}>{displayDate}</time></span>
          <span aria-hidden="true">·</span>
          <span>{mins} min read</span>
        </p>
      </header>

      {post.data.cover && (
        <div class="post-cover">
          <img src={post.data.cover} alt={`Cover image — ${post.data.title}`} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      )}

      <TableOfContents headings={headings} />

      <div class="post-body" data-pagefind-body>
        <Content />
      </div>

      <div class="post-engagement">
        <LikeButton slug={slug} />
      </div>

      <ShareButtons url={url} title={post.data.title} />

      {post.data.tags && post.data.tags.length > 0 && (
        <footer class="post-footer">
          <span>Filed under:</span>
          {post.data.tags.map((t) => (
            <a class="tag" href={`/tags/${tagSlug(t)}/`} rel="tag">{t}</a>
          ))}
        </footer>
      )}

      <AuthorBio />
      <Subscribe variant="banner" />
      <RelatedPosts current={post} />
      <CommentSection slug={slug} originalUrl={post.data.originalUrl} />
    </div>
    <Sidebar currentSlug={slug} />
  </article>
  <EmbedScripts />
</Base>

<style>
  .post-dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--fg-soft);
  }
  .post-dateline .byline {
    font-weight: 600;
    color: var(--fg);
  }
  .post-dateline time {
    color: inherit;
  }
  .post-engagement {
    max-width: var(--measure);
    margin: 2.5rem auto 0;
    display: flex;
    justify-content: center;
  }
</style>
