---
import Base from '../layouts/Base.astro';
import { getAllPosts, postPath, readMinutes, formatDateShort } from '../lib/posts';
import { CATEGORIES, categoryOf } from '../lib/categories';

// A complete, link-only index of every published post — grouped by category,
// newest first. Linked from the footer so every post is one hop from any page:
// this gives crawlers a shallow, complete path to the whole site (helps
// indexing) and readers a full table of contents.
const posts = await getAllPosts();
const groups = CATEGORIES
  .map((cat) => ({ cat, posts: posts.filter((p) => categoryOf(p).key === cat.key) }))
  .filter((g) => g.posts.length > 0);
---

<Base title="All stories" description="Every story on The Geo-Traveller — travel, flights, food, experiences, guides and news, grouped by topic.">
  <h1 class="page-title">All stories</h1>
  <p class="page-subtitle">{posts.length} {posts.length === 1 ? 'story' : 'stories'}, grouped by topic.</p>

  {groups.map((g) => (
    <section class="arch-section">
      <h2 class="arch-heading" style={`border-color:${g.cat.badge.bg}`}>
        <span class="arch-badge" style={`background:${g.cat.badge.bg};color:${g.cat.badge.fg}`}>{g.cat.label}</span>
        <a class="arch-more" href={`/category/${g.cat.key}/`}>Browse {g.cat.label} →</a>
      </h2>
      <ul class="archive-list">
        {g.posts.map((post) => (
          <li>
            <span class="date">{formatDateShort(post.data.publishDate)}</span>
            <a href={postPath(post)}>{post.data.title}</a>
            <span class="read-time">{readMinutes(post)} min</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .arch-section { margin: 0 0 2.5rem; }
  .arch-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--fg);
    padding-bottom: 0.5rem;
    margin: 0 0 1rem;
  }
  .arch-badge {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 5px;
    line-height: 1;
  }
  .arch-more {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .arch-more:hover { color: var(--accent-deep); }
</style>
