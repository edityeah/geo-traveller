---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getAllPosts, postPath, readMinutes, formatDate } from '../lib/posts';
import { CATEGORIES, categoryOf } from '../lib/categories';

const posts = await getAllPosts();
// The featured slot is for long-form / destination posts only. News items
// tagged "Geo Daily" are excluded — they cycle through too fast and dilute
// what the homepage is meant to showcase.
const featuredEligible = posts.filter(
  (p) => categoryOf(p).key !== 'travel-news'
);
const featured = featuredEligible[0] ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
const featuredCat = featured ? categoryOf(featured) : null;
const featuredDate = featured ? formatDate(featured.data.publishDate) : '';
const featuredMins = featured ? readMinutes(featured) : 0;

// Magazine sections, one per type-led category, in CATEGORIES order. Each shows
// its three latest posts; "More →" links to the category landing page.
const sections = CATEGORIES
  .map((cat) => ({
    cat,
    posts: rest.filter((p) => categoryOf(p).key === cat.key).slice(0, 4),
  }))
  .filter((s) => s.posts.length > 0);
---

<Base preloadImage={featured?.data.cover}>
  <div class="with-sidebar">
    <div class="main-col">
      {featured && (
        <a class="featured" href={postPath(featured)}>
          {featured.data.cover ? (
            <div class="cover">
              <img src={featured.data.cover} alt={featured.data.title} width="1200" height="675" fetchpriority="high" decoding="async" />
              {featuredCat && (
                <span class="featured-badge" style={`background:${featuredCat.badge.bg};color:${featuredCat.badge.fg}`}>{featuredCat.label}</span>
              )}
            </div>
          ) : (
            <div class="cover placeholder" aria-hidden="true"></div>
          )}
          <div class="featured-text">
            <div class="kicker">
              Latest · {featuredDate}
              {featured.data.locationName && ` · ${featured.data.locationName}`}
              {` · ${featuredMins} min read`}
            </div>
            <h2>{featured.data.title}</h2>
            {featured.data.excerpt && <p class="excerpt">{featured.data.excerpt}</p>}
            <span class="read-more">Read the story →</span>
          </div>
        </a>
      )}

      {sections.map((sec) => (
        <section class="section">
          <header class="section-heading">
            <h2>{sec.cat.label}</h2>
            <a class="see-all" href={`/category/${sec.cat.key}/`}>More →</a>
          </header>
          <div class="post-grid auto">
            {sec.posts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))}
    </div>
    <Sidebar />
  </div>
</Base>
